# Copiá este archivo como .env para correr el monitor en tu PC.
# En GitHub, estos valores van en Settings > Secrets and variables > Actions.

# Obligatoria. Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionales ----------------------------------------------------------------
# Forzar un modelo (si no, se elige solo entre los que habilita tu clave)
# GEMINI_MODELO=gemini-3.5-flash-lite
# Llamadas por minuto y tope diario (dejan margen dentro del plan gratuito)
# GEMINI_RPM=8
# GEMINI_MAX_LLAMADAS_DIA=400
# Piezas curadas por corrida y lugares reservados para cada fuente dentro de ese cupo
# MAX_CURADAS_POR_CORRIDA=60
# CUPO_MINIMO_FUENTE=5

# Nombre y dirección pública del portal (para el RSS y los enlaces de Telegram)
# PORTAL_NOMBRE=Monitor Jurídico AR
# PORTAL_URL=https://tu-usuario.github.io/monitor-juridico

# Orientación editorial para el triage (desempata los casos dudosos)
# PERFIL_EDITORIAL=Defensa pública penal en Tierra del Fuego: priorizar penal, procesal penal y garantías.

# Limitar fuentes (por defecto corren todas): csjn,csjn_noticias,bora,saij,saij_tdf,saij_boletin,mpf,
#   justicia_ar,ijudicial,palabras_derecho,pensamiento_penal,eldial,aldia,diario_judicial,infobae
# FUENTES_ACTIVAS=

# Alertas por Telegram de lo que es alto impacto (crear el bot con @BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Con plan pago de Gemini (que no usa tus datos para entrenar) se puede enviar el
# texto completo también de las fuentes que pidieron "ai-train=no".
# IA_PLAN_PAGO=0
